; Restrained solvent/contact relaxation before HEWL validation equilibration.
define = -DPOSRES
integrator = steep
nsteps = 20000
emtol = 1000
emstep = 0.005
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
rlist = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
pbc = xyz
constraints = none
nstenergy = 100
nstlog = 100
ld-seed = 1729
