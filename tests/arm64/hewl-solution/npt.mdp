; 20 ps restrained NPT; continue velocities from NVT without regenerating them.
define = -DPOSRES
integrator = md
dt = 0.001
nsteps = 20000
continuation = yes
gen-vel = no
ld-seed = 161803
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
rlist = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
pbc = xyz
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 8
lincs-iter = 2
tcoupl = v-rescale
tc-grps = Protein SOL
tau-t = 0.5 0.5
ref-t = 310 310
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
refcoord-scaling = com
nstenergy = 100
nstlog = 100
nstxout-compressed = 1000
nstxout = 0
nstvout = 0
nstfout = 0
