; 10 ps restrained NVT at 310 K: bounded validation preparation, not production.
define = -DPOSRES
integrator = md
dt = 0.001
nsteps = 10000
continuation = no
gen-vel = yes
gen-temp = 310
gen-seed = 314159
ld-seed = 271828
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
rlist = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
pbc = xyz
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 8
lincs-iter = 2
tcoupl = v-rescale
tc-grps = Protein SOL
tau-t = 0.5 0.5
ref-t = 310 310
pcoupl = no
nstenergy = 100
nstlog = 100
nstxout-compressed = 1000
nstxout = 0
nstvout = 0
nstfout = 0
